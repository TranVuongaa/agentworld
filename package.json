{
  "name": "agentworld",
  "version": "0.7.5",
  "description": "Run a team of AI coding agents (Claude Code, Codex) on your repo in Docker Sandboxes, and watch them work in a pixel-art office.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/TranVuongaa/agentworld#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TranVuongaa/agentworld.git"
  },
  "bugs": {
    "url": "https://github.com/TranVuongaa/agentworld/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "ai-agents",
    "multi-agent",
    "agent-orchestration",
    "coding-agents",
    "claude",
    "claude-code",
    "codex",
    "docker-sandboxes",
    "mcp",
    "pixel-art",
    "developer-tools"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "build": "next build && tsc --noEmit -p server && node scripts/build-server.mjs",
    "start": "node bin/agentworld.mjs",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p server",
    "postinstall": "node scripts/fix-node-pty.mjs",
    "test:backend": "node scripts/run-test.mjs scripts/session-backend-test.ts && node scripts/run-test.mjs scripts/workspace-test.ts",
    "test:smoke": "node scripts/smoke-test.mjs",
    "prepack": "npm run build",
    "test:package": "npm run build && node scripts/package-test.mjs",
    "test:browser": "node scripts/browser-test.mjs",
    "test:github-sync": "node scripts/run-test.mjs scripts/github-sync-test.mjs",
    "test:hmr": "node scripts/hmr-test.mjs",
    "test:access": "node scripts/run-test.mjs scripts/access-test.mjs",
    "test:sbx-sync": "node scripts/run-test.mjs scripts/sbx-sync-test.mjs",
    "db:migrate": "node scripts/migrate-saas.mjs",
    "test:saas": "node scripts/run-test.mjs scripts/saas-crypto-test.ts",
    "test:saas-db": "node scripts/run-test.mjs scripts/saas-db-test.ts",
    "local": "node scripts/local.mjs",
    "test:managed-credentials": "node scripts/run-test.mjs scripts/managed-credentials-test.ts",
    "test:github-app": "node scripts/run-test.mjs scripts/github-app-token-test.ts",
    "test:mcp-project": "node scripts/run-test.mjs scripts/mcp-project-test.ts",
    "test:project-gateway": "node scripts/run-test.mjs scripts/project-gateway-test.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/headless": "5.5.0",
    "@xterm/xterm": "^5.5.0",
    "framer-motion": "^11.18.2",
    "next": "^15.5.0",
    "pg": "^8.23.1",
    "pixi.js": "^8.22.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.65.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3"
  },
  "bin": {
    "agentworld": "bin/agentworld.mjs"
  },
  "files": [
    "app",
    "bin",
    "server",
    "src",
    "docs",
    "scripts/fix-node-pty.mjs",
    "next.config.mjs",
    "postcss.config.mjs",
    "tsconfig.json",
    ".next/BUILD_ID",
    ".next/*.json",
    ".next/server",
    ".next/static",
    "dist-server/main.mjs"
  ]
}
