# Copy to .env.local. Generate a key using: openssl rand -base64 32
DATABASE_URL=postgres://agentworld:agentworld-local@127.0.0.1:54329/agentworld
SAAS_ENCRYPTION_KEY=
SAAS_APP_URL=http://127.0.0.1:7420
# GitHub App credentials; callback URL must match SAAS_APP_URL/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub App private key used for repository-scoped installation tokens (not needed for local gh mode)
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_SLUG=
# Local development only: use the gh CLI login, never enable on a public server.
SAAS_LOCAL_DEV=0
